{
  "name": "alternativa-despesas-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:preserve": "KEEP=$(mktemp -d) && ([ -d dist/src/uploads ] && cp -a dist/src/uploads \"$KEEP/uploads\" || true) && ([ -f .env ] && cp -a .env \"$KEEP/.env\" || true) && rm -rf dist && npm run build && mkdir -p dist/src/uploads && ([ -d \"$KEEP/uploads\" ] && cp -a \"$KEEP/uploads\"/. dist/src/uploads/ || true) && ([ -f \"$KEEP/.env\" ] && cp -a \"$KEEP/.env\" .env || true) && rm -rf \"$KEEP\"",
    "format": "biome format --write src test",
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:debug": "node --inspect -r tsx/cjs src/main.ts",
    "start:prod": "node dist/main",
    "lint": "biome lint src test",
    "lint:fix": "biome lint --write src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "node --inspect-brk ./node_modules/vitest/vitest.mjs run --no-file-parallelism",
    "test:e2e": "node --test -r ts-node/register -r tsconfig-paths/register test/app.e2e-spec.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "db:migration-create": "npm run typeorm -- migration:create ./src/infra/db/migrations/${1}",
    "db:migration-run": "npm run typeorm -- migration:run -d ./ormconfig.ts",
    "db:migration-revert": "npm run typeorm -- migration:revert -d ./ormconfig.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "class-validator-cpf": "^1.1.1",
    "csv-parse": "^6.1.0",
    "discord.js": "^14.25.1",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "openai": "^6.36.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/testing": "^11.1.17",
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.1.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "js-yaml": "5.2.2",
    "typeorm": {
      "glob": "13.0.6"
    }
  }
}
